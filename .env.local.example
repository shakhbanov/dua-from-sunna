# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; values never reach the public repository.

# Yandex.Metrika counter ID (digits only)
# https://metrika.yandex.ru — the tracking code is injected at build time
VITE_YANDEX_METRIKA_ID=

# Yandex.Webmaster verification code (string between "yandex_" and ".html")
# Build will generate public/yandex_<CODE>.html
VITE_YANDEX_WEBMASTER_CODE=

# Google Search Console verification code (string between "google" and ".html")
# Build will generate public/google<CODE>.html
VITE_GOOGLE_VERIFICATION_CODE=
