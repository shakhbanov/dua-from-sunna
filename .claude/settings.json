{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "Personal Project Deploy: This is the user's personal single-maintainer project. Pushing to origin/main and origin/gh-pages is the normal deploy workflow (no PR review process exists). Force push, reset --hard, and other destructive git operations are still covered by the deny list in permissions."
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /root)",
      "Bash(rm -rf /root/*)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf /var*)",
      "Bash(rm -rf /home*)",
      "Bash(rm -rf /bin*)",
      "Bash(rm -rf /sbin*)",
      "Bash(rm -rf /lib*)",
      "Bash(rm -rf /boot*)",
      "Bash(rm -rf /opt*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout --*)",
      "Bash(git branch -D *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(:(){*)"
    ]
  }
}
