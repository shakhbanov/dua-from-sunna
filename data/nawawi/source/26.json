  "title": {
    "ru": "Каждый сустав человека обязан милостыней",
    "en": "Every joint of a person owes charity"
  },
  "slug": {
    "ru": "kazhdyy-sustav-cheloveka-obyazan-milostyney",
    "en": "every-joint-of-a-person-owes-charity"
