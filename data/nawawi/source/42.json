  "title": {
    "ru": "О сын Адама, пока ты взываешь ко Мне",
    "en": "O son of Adam, so long as you call upon Me"
  },
  "slug": {
    "ru": "o-syn-adama-poka-ty-vzyvaesh-ko-mne",
    "en": "o-son-of-adam-so-long-as-you-call-upon-me"
