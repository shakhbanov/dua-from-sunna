  "title": {
    "ru": "Помни об Аллахе, и Он сохранит тебя",
    "en": "Be mindful of Allah and He will protect you"
  },
  "slug": {
    "ru": "pomni-ob-allahe-i-on-sohranit-tebya",
    "en": "be-mindful-of-allah-and-he-will-protect-you"
